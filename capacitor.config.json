{
  "appId": "com.artjmarcos.mahjongtour",
  "appName": "Mahjong World Tour",
  "webDir": ".",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false,
    "backgroundColor": "#0b1512"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "backgroundColor": "#0b1512",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#0b1512",
      "overlaysWebView": false
    },
    "NavigationBar": {
      "backgroundColor": "#0b1512",
      "style": "LIGHT"
    }
  },
  "cordova": {}
}
